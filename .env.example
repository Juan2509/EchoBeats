# Plantilla; generar .env con scripts/preparar_entorno.py. No incluir claves reales aquí.
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MEDIA_ROOT=./data/media
# Preparar el .env con: python3 scripts/preparar_entorno.py
POSTGRES_DB=echobeats
POSTGRES_USER=echobeats
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Opcional en ejecución nativa; vacía usa los campos POSTGRES_*.
# Dentro de Compose, host/puerto internos se fijan a postgres:5432.
DATABASE_URL=
# Trabajador local de preparación de metadatos (sin IA). Desactivar pausa la cola.
PROCESSING_WORKER_ENABLED=true
# IA P20: privada, desactivada por defecto. Nunca usar prefijo VITE_ para claves.
AI_ENABLED=false
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_GENERATION_MODEL=gpt-6-luna
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_RETRIES=0
