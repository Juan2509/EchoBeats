# Copiar a .env. No incluir claves reales en este archivo.
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MEDIA_ROOT=./data/media
# Se configurará con PostgreSQL en P04. P03 no necesita una BD para iniciar.
DATABASE_URL=
# Proveedor de IA y credenciales se definirán en P20; no se exponen al frontend.
