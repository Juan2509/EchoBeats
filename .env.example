# Plantilla; generar .env con scripts/preparar_entorno.py. No incluir claves reales aquí.
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MEDIA_ROOT=./data/media
# Preparar el .env con: python3 scripts/preparar_entorno.py
POSTGRES_DB=echobeats
POSTGRES_USER=echobeats
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Opcional en ejecución nativa; vacía usa los campos POSTGRES_*.
# Dentro de Compose, host/puerto internos se fijan a postgres:5432.
DATABASE_URL=
# Proveedor de IA y credenciales se definirán en P20; no se exponen al frontend.
